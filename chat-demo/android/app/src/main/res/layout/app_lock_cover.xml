<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/page_background" android:fillViewport="true"
    android:clickable="true" android:focusable="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingLeft="24dp" android:paddingRight="24dp"
        android:paddingTop="32dp" android:paddingBottom="28dp">
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.85" />
        <LinearLayout android:id="@+id/lock_message" android:orientation="vertical"
            android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:layout_width="68dp" android:layout_height="52dp"
                android:src="@drawable/app_lock_whale" android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:gravity="center"
                android:text="@string/app_lock_title" android:textColor="@color/lock_ink"
                android:fontFamily="sans-serif-medium" android:textSize="24sp" />
            <TextView android:id="@+id/lock_hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:maxWidth="320dp"
                android:accessibilityLiveRegion="polite" android:lineSpacingExtra="3dp"
                android:text="@string/app_lock_hint" android:textColor="@color/lock_secondary" android:textSize="15sp" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1.15" />
        <Button android:id="@+id/lock_unlock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="28dp" android:paddingLeft="28dp" android:paddingRight="28dp"
            android:paddingTop="10dp" android:paddingBottom="10dp" android:gravity="center"
            android:background="@drawable/app_lock_button" android:backgroundTint="@null"
            android:stateListAnimator="@null" android:elevation="0dp" android:letterSpacing="0"
            android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:textSize="17sp"
            android:textColor="@color/lock_on_action" android:text="@string/app_lock_action" />
    </LinearLayout>
</ScrollView>
